{
  "id": null,
  "uid": null,
  "title": "Agent token efficiency",
  "description": "Reporting-only Claude Code dashboard built from the verified signal catalogue in issue #471.",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "agentTelemetry": {
    "missingDimensions": [
      "github_issue",
      "git_branch"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "logs",
        "label": "Events datasource",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(claude_code_session_count_total, session_id)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Session cost",
      "decision": "session-cost",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": [
        {
          "id": 2,
          "type": "timeseries",
          "title": "Estimated cost by session and model",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (session_id, model) (increase(claude_code_cost_usage_USD_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{session_id}} {{model}}",
              "catalogueRef": "metrics:claude_code.cost.usage"
            }
          ]
        },
        {
          "id": 3,
          "type": "timeseries",
          "title": "Tokens by session, model, and type",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (session_id, model, type) (increase(claude_code_token_usage_tokens_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{session_id}} {{model}} {{type}}",
              "catalogueRef": "metrics:claude_code.token.usage"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "API token mix",
      "decision": "api-token-mix",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "panels": [
        {
          "id": 5,
          "type": "timeseries",
          "title": "Input, output, cache-read, and cache-creation tokens per request",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 9, "w": 16, "x": 0, "y": 10},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"input\" | unwrap input_tokens [$__interval]))",
              "legendFormat": "input",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"output\" | unwrap output_tokens [$__interval]))",
              "legendFormat": "output",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "C",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"cache-read\" | unwrap cache_read_tokens [$__interval]))",
              "legendFormat": "cache-read",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "D",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"cache-creation\" | unwrap cache_creation_tokens [$__interval]))",
              "legendFormat": "cache-creation",
              "catalogueRef": "events:api_request"
            }
          ]
        },
        {
          "id": 20,
          "type": "timeseries",
          "title": "API request round trips by session",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 9, "w": 8, "x": 16, "y": 10},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (session_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" [${__interval}]))",
              "legendFormat": "{{session_id}} requests",
              "catalogueRef": "events:api_request"
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Context and compaction",
      "decision": "context-compaction",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19},
      "panels": [
        {
          "id": 7,
          "type": "timeseries",
          "title": "Context tokens per API request (p50, p95, max)",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 16, "x": 0, "y": 20},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "quantile_over_time(0.50, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format context_tokens=\"{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}\" | unwrap context_tokens [$__interval]) by (session_id)",
              "legendFormat": "p50 context tokens",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format context_tokens=\"{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}\" | unwrap context_tokens [$__interval]) by (session_id)",
              "legendFormat": "p95 context tokens",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "C",
              "queryType": "range",
              "expr": "max_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format context_tokens=\"{{ add .input_tokens .cache_read_tokens .cache_creation_tokens }}\" | unwrap context_tokens [$__interval]) by (session_id)",
              "legendFormat": "max context tokens",
              "catalogueRef": "events:api_request"
            }
          ]
        },
        {
          "id": 8,
          "type": "timeseries",
          "title": "Compacted API requests by session",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (session_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | query_source=\"compact\" [$__interval]))",
              "legendFormat": "{{session_id}} compacted requests",
              "catalogueRef": "events:api_request"
            }
          ]
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Tool health",
      "decision": "tool-health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "panels": [
        {
          "id": 10,
          "type": "timeseries",
          "title": "Tool volume and failures",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 8, "x": 0, "y": 29},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" [$__interval]))",
              "legendFormat": "{{tool_name}} total",
              "catalogueRef": "events:tool_result"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | success=\"false\" | session_id=~\"$session\" [$__interval]))",
              "legendFormat": "{{tool_name}} failed",
              "catalogueRef": "events:tool_result"
            }
          ]
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Tool active and wall duration",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 8, "x": 8, "y": 29},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "avg by (tool_name) (avg_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" | unwrap duration_ms [$__interval]))",
              "legendFormat": "{{tool_name}} wall ms",
              "catalogueRef": "events:tool_result"
            },
            {
              "refId": "B",
              "expr": "sum by (type) (increase(claude_code_active_time_seconds_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{type}} active seconds",
              "datasource": {"type": "prometheus", "uid": "${metrics}"},
              "catalogueRef": "metrics:claude_code.active_time.total"
            }
          ]
        },
        {
          "id": 21,
          "type": "timeseries",
          "title": "Tool result size by tool",
          "description": "The p95 series uses the right axis so it remains readable next to total bytes.",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 29},
          "fieldConfig": {
            "defaults": {},
            "overrides": [
              {
                "matcher": {"id": "byName", "options": "p95 bytes"},
                "properties": [{"id": "custom.axisPlacement", "value": "right"}]
              }
            ]
          },
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (tool_name) (sum_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" | unwrap tool_result_size_bytes [$__interval]))",
              "legendFormat": "{{tool_name}} total bytes",
              "catalogueRef": "events:tool_result"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "quantile_over_time(0.95, {service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" | unwrap tool_result_size_bytes [$__interval]) by (tool_name)",
              "legendFormat": "p95 bytes",
              "catalogueRef": "events:tool_result"
            }
          ]
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Attribution",
      "decision": "attribution",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37},
      "panels": [
        {
          "id": 13,
          "type": "timeseries",
          "title": "Estimated cost by model, source, and effort",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 16, "x": 0, "y": 38},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (model, query_source, effort) (increase(claude_code_cost_usage_USD_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{model}} {{query_source}} {{effort}}",
              "catalogueRef": "metrics:claude_code.cost.usage"
            }
          ]
        },
        {
          "id": 14,
          "type": "text",
          "title": "Unavailable attribution",
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 38},
          "options": {
            "mode": "markdown",
            "content": "Main/subagent attribution uses the observed `query_source` attribute. `agent_id` and `skill_name` were not observed and remain unavailable rather than being displayed as zero."
          }
        }
      ]
    }
  ]
}
