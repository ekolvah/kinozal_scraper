{
  "id": null,
  "uid": null,
  "title": "Agent token efficiency",
  "description": "Reporting-only Claude Code and Codex dashboard built from verified signal catalogues in issues #471 and #472.",
  "schemaVersion": 42,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "agentTelemetry": {
    "missingDimensions": [
      "github_issue",
      "git_branch"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "logs",
        "label": "Events datasource",
        "type": "datasource",
        "query": "loki"
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(claude_code_session_count_total, session_id)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Session cost",
      "decision": "session-cost",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": [
        {
          "id": 2,
          "type": "timeseries",
          "title": "Estimated cost by session and model",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (session_id, model) (increase(claude_code_cost_usage_USD_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{session_id}} {{model}}",
              "catalogueRef": "metrics:claude_code.cost.usage"
            }
          ]
        },
        {
          "id": 3,
          "type": "timeseries",
          "title": "Tokens by session, model, and type",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (session_id, model, type) (increase(claude_code_token_usage_tokens_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{session_id}} {{model}} {{type}}",
              "catalogueRef": "metrics:claude_code.token.usage"
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "API token mix",
      "decision": "api-token-mix",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "panels": [
        {
          "id": 5,
          "type": "timeseries",
          "title": "Input, output, cache-read, and cache-creation tokens per request",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"input\" | unwrap input_tokens [$__interval]))",
              "legendFormat": "input",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"output\" | unwrap output_tokens [$__interval]))",
              "legendFormat": "output",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "C",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"cache-read\" | unwrap cache_read_tokens [$__interval]))",
              "legendFormat": "cache-read",
              "catalogueRef": "events:api_request"
            },
            {
              "refId": "D",
              "queryType": "range",
              "expr": "sum by (type) (sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | session_id=~\"$session\" | label_format type=\"cache-creation\" | unwrap cache_creation_tokens [$__interval]))",
              "legendFormat": "cache-creation",
              "catalogueRef": "events:api_request"
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Context and compaction",
      "decision": "context-compaction",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19},
      "panels": [
        {
          "id": 7,
          "type": "timeseries",
          "title": "Context-size proxy: input plus cache tokens per request",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 16, "x": 0, "y": 20},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (session_id) (increase(claude_code_token_usage_tokens_total{session_id=~\"$session\", type=~\"input|cacheRead|cacheCreation\"}[$__rate_interval]))",
              "legendFormat": "{{session_id}} context proxy",
              "catalogueRef": "metrics:claude_code.token.usage"
            }
          ]
        },
        {
          "id": 8,
          "type": "text",
          "title": "Compaction availability",
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
          "options": {
            "mode": "markdown",
            "content": "Compaction was not observed in the bounded live capture. It is unavailable, not zero. Re-capture the catalogue after the first compacted session before adding a query."
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Tool health",
      "decision": "tool-health",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "panels": [
        {
          "id": 10,
          "type": "timeseries",
          "title": "Tool volume and failures",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" [$__interval]))",
              "legendFormat": "{{tool_name}} total",
              "catalogueRef": "events:tool_result"
            },
            {
              "refId": "B",
              "queryType": "range",
              "expr": "sum by (tool_name) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | success=\"false\" | session_id=~\"$session\" [$__interval]))",
              "legendFormat": "{{tool_name}} failed",
              "catalogueRef": "events:tool_result"
            }
          ]
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Tool active and wall duration",
          "datasource": {"type": "loki", "uid": "${logs}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
          "targets": [
            {
              "refId": "A",
              "queryType": "range",
              "expr": "avg by (tool_name) (avg_over_time({service_name=\"claude-code\"} | event_name=\"tool_result\" | session_id=~\"$session\" | unwrap duration_ms [$__interval]))",
              "legendFormat": "{{tool_name}} wall ms",
              "catalogueRef": "events:tool_result"
            },
            {
              "refId": "B",
              "expr": "sum by (type) (increase(claude_code_active_time_seconds_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{type}} active seconds",
              "datasource": {"type": "prometheus", "uid": "${metrics}"},
              "catalogueRef": "metrics:claude_code.active_time.total"
            }
          ]
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Attribution",
      "decision": "attribution",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37},
      "panels": [
        {
          "id": 13,
          "type": "timeseries",
          "title": "Estimated cost by model, source, and effort",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 16, "x": 0, "y": 38},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (model, query_source, effort) (increase(claude_code_cost_usage_USD_total{session_id=~\"$session\"}[$__rate_interval]))",
              "legendFormat": "{{model}} {{query_source}} {{effort}}",
              "catalogueRef": "metrics:claude_code.cost.usage"
            }
          ]
        },
        {
          "id": 14,
          "type": "text",
          "title": "Unavailable attribution",
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 38},
          "options": {
            "mode": "markdown",
            "content": "Main/subagent attribution uses the observed `query_source` attribute. `agent_id` and `skill_name` were not observed and remain unavailable rather than being displayed as zero."
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Codex implementer",
      "decision": "codex-usage",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 46},
      "panels": [
        {
          "id": 16,
          "type": "timeseries",
          "title": "Codex tokens by model and type",
          "description": "Unavailable Codex samples remain unavailable and are never rendered as zero.",
          "source": "codex",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 0, "y": 47},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (model, token_type, originator, session_source) (increase(codex_turn_token_usage_sum[$__rate_interval]))",
              "legendFormat": "{{model}} {{token_type}} {{originator}} {{session_source}}",
              "catalogueRef": "metrics:codex.turn.token_usage",
              "source": "codex"
            }
          ]
        },
        {
          "id": 17,
          "type": "timeseries",
          "title": "Codex tool calls by model and source",
          "description": "Native metrics expose aggregate tool-call volume, not tool names or success; unavailable samples remain unavailable.",
          "source": "codex",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 12, "x": 12, "y": 47},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (model, originator, session_source) (increase(codex_turn_tool_call_sum[$__rate_interval]))",
              "legendFormat": "{{model}} {{originator}} {{session_source}}",
              "catalogueRef": "metrics:codex.turn.tool_call",
              "source": "codex"
            }
          ]
        },
        {
          "id": 18,
          "type": "timeseries",
          "title": "Average Codex turn duration",
          "description": "Average completed-turn duration from the captured histogram; unavailable samples remain unavailable.",
          "source": "codex",
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "gridPos": {"h": 8, "w": 16, "x": 0, "y": 55},
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (model, originator, session_source) (rate(codex_turn_e2e_duration_ms_milliseconds_sum[$__rate_interval])) / sum by (model, originator, session_source) (rate(codex_turn_e2e_duration_ms_milliseconds_count[$__rate_interval]))",
              "legendFormat": "{{model}} {{originator}} {{session_source}}",
              "catalogueRef": "metrics:codex.turn.e2e_duration_ms",
              "source": "codex"
            }
          ]
        },
        {
          "id": 19,
          "type": "text",
          "title": "Codex attribution boundary",
          "description": "Unavailable issue and branch dimensions remain visible instead of being inferred.",
          "source": "codex",
          "gridPos": {"h": 8, "w": 8, "x": 16, "y": 55},
          "options": {
            "mode": "markdown",
            "content": "Issue/branch attribution is unavailable in native Codex metrics. Compare source totals here; do not claim a planner + implementer total for one GitHub issue."
          }
        }
      ]
    }
  ]
}
