{
  "permissions": {
    "deny": [
      "Bash(sleep:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/token_trend.py\" --hook",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/agent-process-check.py\" https://github.com/ekolvah/agent-process-distribution/blob/v3.10.1/skills/agent-process/SKILL.md#install"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-process-marketplace": {
      "source": {
        "source": "github",
        "repo": "ekolvah/agent-process-distribution",
        "ref": "stable"
      },
      "autoUpdate": true
    }
  }
}
