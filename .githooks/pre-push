#!/usr/bin/env bash
# Локальное surfacing перед push'ем — НЕ enforcement: `.githooks` включается опциональным
# `git config core.hooksPath .githooks`. Авторитетный барьер для `main` — branch protection
# на стороне GitHub (docs/architecture/ci.md).
#
# Интерпретатор ПРОБИРУЕТСЯ (`-c ''`), а не выводится из кода возврата гейта. Прежняя цепочка
# `гейт || следующий-интерпретатор` толковала красный гейт как «интерпретатор не тот» и
# перезапускала весь ci_check (минуты) под следующим кандидатом, а stderr первого прогона
# глотала `2>/dev/null` (#436). Поэтому `2>/dev/null` остался только на пробе.
set -u

PY=""
for candidate in ".venv/Scripts/python" ".venv/bin/python" "py -3.12"; do
    # Без кавычек намеренно: "py -3.12" — это команда вместе с аргументом.
    # shellcheck disable=SC2086
    if $candidate -c "" 2>/dev/null; then
        PY="$candidate"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "pre-push: не найден Python (пробовал .venv/Scripts/python, .venv/bin/python, py -3.12)" >&2
    exit 1
fi

# Сначала дешёвая сетевая сверка (секунды), потом тяжёлый гейт (минуты): дрейф required-контекстов
# не должен стоить полного прогона ci_check, прежде чем о нём скажут. Обе формы отказа блокируют
# push, но код возврата пробрасывается как есть (`exit $?`), чтобы «дрейф» (1) и «инструмент не
# сработал» (2) различались снаружи, а не схлопывались в один.
if [ "${BRANCH_PROTECTION_ALLOW_DRIFT+x}" = x ]; then
    # A non-empty value documents the exceptional migration in the push output.
    # An empty exported value reaches argparse and fails visibly instead of silently
    # disabling the drift detector.
    # shellcheck disable=SC2086
    $PY scripts/check_branch_protection.py --allow-drift "$BRANCH_PROTECTION_ALLOW_DRIFT" || exit $?
else
    # shellcheck disable=SC2086
    $PY scripts/check_branch_protection.py || exit $?
fi
# shellcheck disable=SC2086
$PY scripts/ci_check.py || exit $?
